; Brisa — Barcelona by car. Open with Godot 4.5 stable.
config_version=5

[application]
config/name="Brisa — Barcelona"
config/icon="res://assets/icon.svg"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "Forward Plus")
config/description="An original, offline Barcelona-inspired driving postcard."

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=0

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=2
rendering_device/driver.macos="metal"
rendering_device/driver.ios="metal"
environment/defaults/default_clear_color=Color(0.65, 0.81, 0.85, 1)

[physics]
common/physics_ticks_per_second=60

[audio]
driver/enable_input=false
